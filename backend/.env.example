# 复制为 .env 并修改

# 微信登录模式: mock(模拟) | wechaty(真实扫码登录)
WECHAT_MODE=mock

# 微信登录驱动(wechaty 模式)
# 免费网页协议(可能被风控): wechaty-puppet-wechat4u
# 稳定 ipad 协议(需付费 token): 设置 WECHATY_PUPPET=wechaty-puppet-padlocal
WECHATY_PUPPET=wechaty-puppet-wechat4u

# 使用 padlocal 协议时填写 token
PADLOCAL_TOKEN=

# ===== AI 大模型配置(OpenAI 兼容接口) =====
# 请自行申请 API Key 后填写
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_MODEL=gpt-3.5-turbo

# 收到消息是否自动回复
AUTO_REPLY=true

# 回复前缀(可选，留空则无前缀)
REPLY_PREFIX=

# 系统提示词
SYSTEM_PROMPT=你是一个友善、简洁的微信聊天助手，请用中文回复用户，回答尽量简短自然。

# 模拟模式内置联系人
MOCK_CONTACTS=小明,小红,测试群

# 后端端口(前端通过 /api 反向代理访问)
PORT=3001
